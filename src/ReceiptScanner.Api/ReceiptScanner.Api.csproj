<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>ReceiptScanner.Api</RootNamespace>
    <UserSecretsId>receipt-scanner-api</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ReceiptScanner.Core\ReceiptScanner.Core.csproj" />
    <ProjectReference Include="..\ReceiptScanner.Infrastructure\ReceiptScanner.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <!-- Needed in the startup project for `dotnet ef`. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ReceiptScanner.Tests" />
  </ItemGroup>

</Project>
